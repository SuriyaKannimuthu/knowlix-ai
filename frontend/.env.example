# Copy to .env.local and adjust.

# "live" calls the FastAPI backend. Leave unset (or "mock") to run the
# in-browser demo with sample documents and keyword-only retrieval.
NEXT_PUBLIC_API_MODE=mock

# Base path the browser calls. The default "/api" is proxied to BACKEND_URL
# by next.config.ts. Set a full URL (e.g. https://api.example.com) to call the
# backend directly instead; the backend must then allow this origin via CORS.
NEXT_PUBLIC_API_BASE_URL=/api

# FastAPI server that /api/* is rewritten to (read at build/start time).
BACKEND_URL=http://127.0.0.1:8000

# Client-side upload limit in megabytes. Keep in sync with the backend.
NEXT_PUBLIC_MAX_UPLOAD_MB=20
