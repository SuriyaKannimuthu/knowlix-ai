# Copy to .env and adjust. Every variable is optional unless noted.

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- Relational database -------------------------------------------------
# Local default is SQLite. For PostgreSQL (see docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://knowlix:knowlix@localhost:5432/knowlix
DATABASE_URL=sqlite+aiosqlite:///./data/knowlix.db

# --- Vector database -----------------------------------------------------
# Set QDRANT_URL to use a Qdrant server; otherwise Qdrant runs embedded at QDRANT_PATH.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=knowlix_chunks

# --- Auth (required in production: 32+ random characters) ----------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
ACCESS_TOKEN_MINUTES=720

# --- Embeddings: fastembed | openai | gemini | hash ----------------------
EMBEDDING_PROVIDER=fastembed
# Defaults: BAAI/bge-small-en-v1.5 / text-embedding-3-small / gemini-embedding-001
EMBEDDING_MODEL=
MODEL_CACHE_DIR=./data/models

# --- Reranking: cross-encoder | none --------------------------------------
RERANKER_PROVIDER=cross-encoder
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Generation: server-default model (anthropic | openai | gemini) --------
# Users can pick another model in the UI. If GEMINI_API_KEY (or the key for
# your chosen default) is not set here, users enter their own key in the app.
LLM_PROVIDER=gemini
# Defaults per provider: claude-opus-5-5 / gpt-4.1-mini / gemini-2.5-flash
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Claude (LLM_PROVIDER=anthropic). Anthropic has no embeddings API, so keep
# EMBEDDING_PROVIDER=fastembed (or openai/gemini) alongside it.
# ANTHROPIC_API_KEY=
# ANTHROPIC_EFFORT=medium            # low | medium | high | xhigh | max
# ANTHROPIC_MAX_TOKENS=16000         # includes thinking tokens
# ANTHROPIC_REFUSAL_FALLBACK=true    # re-run safety declines on a fallback model

# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Let users pick a provider/model in the UI and send their own API key with each
# question (X-LLM-API-Key header). Keys are used for that request only and are
# never stored or logged. Server keys above, if set, are used when a user has none.
ALLOW_USER_LLM_KEYS=true

# --- Retrieval ------------------------------------------------------------
RETRIEVAL_MODE=hybrid
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_RERANK_SCORE=-4.0

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_MB=20
CHAT_RATE_LIMIT_PER_MINUTE=20
