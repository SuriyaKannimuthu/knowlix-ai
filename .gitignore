# Knowlix AI: monorepo .gitignore (Python/FastAPI backend + Next.js frontend).
# Patterns without a leading slash apply in every folder.

# ---------------------------------------------------------------------------
# Secrets and local configuration: never commit real keys
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ---------------------------------------------------------------------------
# Backend runtime data (SQLite DB, Qdrant index, uploaded files, models)
# ---------------------------------------------------------------------------
backend/data/
*.db
*.sqlite
*.sqlite3
*.db-journal
qdrant_storage/
fastembed_cache/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
pip-wheel-metadata/
.installed.cfg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.vercel/
.turbo/
next-env.d.ts
*.tsbuildinfo
.eslintcache
.npm/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
coverage/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
build/
dist/

# ---------------------------------------------------------------------------
# Logs and debug output
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Local AI-assistant state
# ---------------------------------------------------------------------------
.claude/settings.local.json
